        "headerBackground": "#0E7490",
        "onHeader": "#FFFFFF",
        "onHeaderMuted": "#E0F2F7",
        "heroCard": "#FFFFFF26",
        "tabBarBackground": "#FFFFFF",
        "tabActive": "#C2410C",
        "tabInactive": "#5E717B",
        "link": "#C2410C",
        "success": "#15803D",
        "successContainer": "#DCFCE7",
        "warning": "#92400E",
        "warningContainer": "#FEF3C7",
        "danger": "#B91C1C",
