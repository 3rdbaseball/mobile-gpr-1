{
  "schemaVersion": "2.0",
  "configVersion": "2026.10.26-1",
  "tenant": {
    "id": "harbor",
    "displayName": "Harbor Credit",
    "legalName": "Harbor Credit Co. (fictional)",
    "defaultLocale": "en-US",
    "supportedLocales": [
      "en-US"
    ]
  },
  "theme": {
    "colorSchemeMode": "system",
    "colors": {
      "light": {
        "primary": "#0E7490",
        "onPrimary": "#FFFFFF",
        "secondary": "#C2410C",
        "onSecondary": "#FFFFFF",
        "accent": "#F97316",
        "onAccent": "#1C0A00",
        "background": "#F5F7F8",
        "surface": "#FFFFFF",
